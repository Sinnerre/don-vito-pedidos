<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.31.1">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="P_cli" name="Cliente" processRef="Process_cli" />
    <bpmn:participant id="P_piz" name="Pizzería Don Vito" processRef="Process_piz" />
    <bpmn:messageFlow id="m1" sourceRef="t_pedir" targetRef="t_cargar" />
    <bpmn:messageFlow id="m4" sourceRef="t_entrega" targetRef="t_recibir" />
  </bpmn:collaboration>
  <bpmn:process id="Process_cli" isExecutable="false">
    <bpmn:startEvent id="s_cli" name="Necesita una pizza" />
    <bpmn:userTask id="t_pedir" name="Hacer pedido" />
    <bpmn:endEvent id="e_cli" name="Pizza recibida" />
    <bpmn:userTask id="t_recibir" name="Recibir la pizza" />
    <bpmn:sequenceFlow id="f1" name="" sourceRef="s_cli" targetRef="t_pedir" />
    <bpmn:sequenceFlow id="f2" name="" sourceRef="t_pedir" targetRef="t_recibir" />
    <bpmn:sequenceFlow id="f3" name="" sourceRef="t_recibir" targetRef="e_cli" />
  </bpmn:process>
  <bpmn:process id="Process_piz" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="L_rep" name="Repartidor">
        <bpmn:flowNodeRef>e_piz</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_entrega</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_coc" name="Cocina">
        <bpmn:flowNodeRef>t_prep</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_enc" name="Encargado">
        <bpmn:flowNodeRef>t_cargar</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_sis" name="Sistema">
        <bpmn:flowNodeRef>t_stock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_stock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_nostock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_nostock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_reg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_pago</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_nopago</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_nopago</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_comp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_asig</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_rep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_espera</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_1hnv4sx</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:userTask id="t_cargar" name="Cargar pedido en el sistema" />
    <bpmn:serviceTask id="t_stock" name="Verificar stock" />
    <bpmn:exclusiveGateway id="g_stock" name="¿Hay stock?" />
    <bpmn:serviceTask id="t_nostock" name="Avisar al cliente: sin stock" />
    <bpmn:endEvent id="e_nostock" name="Pedido cancelado (sin stock)" />
    <bpmn:serviceTask id="t_reg" name="Registrar pedido y descontar insumos" />
    <bpmn:exclusiveGateway id="g_pago" name="¿Pago aprobado?" />
    <bpmn:serviceTask id="t_nopago" name="Avisar al cliente: pago rechazado" />
    <bpmn:endEvent id="e_nopago" name="Pedido cancelado (pago rechazado)" />
    <bpmn:serviceTask id="t_comp" name="Generar comprobante de venta" />
    <bpmn:userTask id="t_prep" name="Preparar pizza" />
    <bpmn:serviceTask id="t_asig" name="Asignar repartidor y activar tracking" />
    <bpmn:exclusiveGateway id="g_rep" name="¿Hay repartidor disponible?">
      <bpmn:incoming>Flow_09to9rw</bpmn:incoming>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="e_piz" name="Pedido entregado" />
    <bpmn:serviceTask id="t_espera" name="Esperar repartidor libre" />
    <bpmn:exclusiveGateway id="Gateway_1hnv4sx" name="¿Es delivery?">
      <bpmn:incoming>f14</bpmn:incoming>
      <bpmn:outgoing>Flow_09to9rw</bpmn:outgoing>
      <bpmn:outgoing>Flow_1cx14v1</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="t_entrega" name="Retirar y entregar pedido">
      <bpmn:incoming>Flow_1cx14v1</bpmn:incoming>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="f4" name="" sourceRef="t_cargar" targetRef="t_stock" />
    <bpmn:sequenceFlow id="f5" name="" sourceRef="t_stock" targetRef="g_stock" />
    <bpmn:sequenceFlow id="f6" name="Sí" sourceRef="g_stock" targetRef="t_reg" />
